    {
      "code": "partial_budget_grant",
      "family": "budget",
      "meaning_cn": "预算只获得部分授予，需显式保留剩余缺口。",
      "allowed_in_schemas": [
        "capacity-reservation.v1",
        "budget-arbitration-record.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "allocator-role",
        "queue-dispatcher"
      ],
      "consumer_required_behavior": "must_preserve_partial_grant",
      "forbidden_synonyms": [
