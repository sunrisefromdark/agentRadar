{
  "schema_version": "reason-code-registry.v1",
  "status": "active",
  "codes": [
    {
      "code": "budget_exceeded",
      "family": "budget",
      "meaning_cn": "预算已达到当前 policy 允许上限。",
      "allowed_in_schemas": [
        "capacity-reservation.v1",
        "failure-notice.v1",
        "weekly-industry-trend-section.v2"
      ],
      "producer_roles": [
        "allocator-role",
        "main-coordinator-if-present"
      ],
      "consumer_required_behavior": "must_degrade_or_defer",
      "forbidden_synonyms": [
        "over_budget",
        "budget_limit_hit"
      ]
    },
    {
      "code": "capacity_exhausted",
      "family": "capacity",
      "meaning_cn": "共享池或 reservation lane 容量已耗尽。",
      "allowed_in_schemas": [
        "capacity-reservation.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "allocator-role",
        "queue-dispatcher"
      ],
      "consumer_required_behavior": "must_queue_or_defer",
      "forbidden_synonyms": [
        "pool_exhausted",
        "slot_full"
      ]
    },
    {
      "code": "timeout_budget_exhausted",
      "family": "budget",
      "meaning_cn": "当前关键路径剩余时间不足以继续启动该动作。",
      "allowed_in_schemas": [
        "failure-notice.v1",
        "weekly-industry-trend-section.v2"
      ],
      "producer_roles": [
        "main-coordinator-if-present",
        "allocator-role"
      ],
      "consumer_required_behavior": "must_stop_same_run_expansion",
      "forbidden_synonyms": [
        "time_budget_hit",
        "timeout_limit_hit"
      ]
    },
    {
      "code": "late_snapshot_cutoff",
      "family": "snapshot",
      "meaning_cn": "结果晚于当前 snapshot cutoff，不能直接回写本轮结论。",
      "allowed_in_schemas": [
        "failure-notice.v1",
        "same-run-dispatch-context.v1"
      ],
      "producer_roles": [
        "queue-dispatcher",
        "weekly-packager"
      ],
      "consumer_required_behavior": "must_reroute_to_next_run_or_rerun",
      "forbidden_synonyms": [
        "late_result",
        "missed_cutoff"
      ]
    },
    {
      "code": "schema_mismatch",
      "family": "schema",
      "meaning_cn": "消息 kind 与 payload schema 或字段契约不匹配。",
      "allowed_in_schemas": [
        "industry-agent-message.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "queue-dispatcher",
        "schema-validator"
      ],
      "consumer_required_behavior": "must_reject",
      "forbidden_synonyms": [
        "payload_mismatch",
        "invalid_schema"
      ]
    },
    {
      "code": "unsupported_version",
      "family": "schema",
      "meaning_cn": "consumer 不支持当前 major/minor 版本。",
      "allowed_in_schemas": [
        "industry-agent-message.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "queue-dispatcher",
        "consumer-runtime"
      ],
      "consumer_required_behavior": "must_reject_and_emit_failure_notice",
      "forbidden_synonyms": [
        "unknown_version",
        "version_not_supported"
      ]
    },
    {
