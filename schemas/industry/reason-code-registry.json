    },
    {
      "code": "settlement_superseded",
      "family": "budget",
      "meaning_cn": "同一预算作用域已有后继结算记录。",
      "allowed_in_schemas": [
        "budget-arbitration-record.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "allocator-role",
        "main-coordinator-if-present"
      ],
      "consumer_required_behavior": "must_use_latest_settlement",
      "forbidden_synonyms": [
