      "family": "review",
      "meaning_cn": "仍有未关闭的 P0 review，阻断当前输出域。",
      "allowed_in_schemas": [
        "human-review-queue-item.v1",
        "weekly-industry-trend-section.v2"
      ],
      "producer_roles": [
        "human-review-service",
        "weekly-packager"
      ],
      "consumer_required_behavior": "must_block_configured_scope",
      "forbidden_synonyms": [
        "p0_waiting_review"
      ]
    },
    {
