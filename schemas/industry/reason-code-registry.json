        "human-review-queue-item.v1",
        "weekly-industry-trend-section.v2"
      ],
      "producer_roles": [
        "human-review-service",
        "weekly-packager"
      ],
      "consumer_required_behavior": "must_degrade_readiness_or_confidence",
      "forbidden_synonyms": [
        "p1_waiting_review"
      ]
    },
    {
      "code": "review_pending_p2",
      "family": "review",
      "meaning_cn": "仍有未关闭的 P2 review，默认进入 backlog 或后补治理。",
      "allowed_in_schemas": [
        "human-review-queue-item.v1",
        "weekly-industry-trend-section.v2"
      ],
      "producer_roles": [
        "human-review-service",
        "weekly-packager"
      ],
      "consumer_required_behavior": "may_keep_internal_and_defer",
      "forbidden_synonyms": [
        "p2_waiting_review"
      ]
    },
    {
      "code": "authority_hold",
      "family": "authority",
      "meaning_cn": "authority 认定尚未通过，禁止把主体晋升到更高 authority tier。",
      "allowed_in_schemas": [
        "registry-review-result.v1",
        "weekly-industry-trend-section.v2",
        "human-review-queue-item.v1"
      ],
      "producer_roles": [
        "registry-agent",
        "audit-agent"
      ],
      "consumer_required_behavior": "must_block_authority_promotion",
      "forbidden_synonyms": [
        "authority_pending",
        "hold_authority"
      ]
    },
    {
      "code": "owner_arbitration_unresolved",
      "family": "normalization",
      "meaning_cn": "事实 owner 主语义尚未定案，不能静默固化为最终 owner。",
      "allowed_in_schemas": [
        "fact-resolution-audit.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "normalization-agent"
      ],
      "consumer_required_behavior": "must_keep_provisional_or_reroute_to_review",
      "forbidden_synonyms": [
        "owner_conflict",
        "owner_pending"
      ]
