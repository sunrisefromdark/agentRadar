      "family": "dispatch",
      "meaning_cn": "需要 same-run 调度的消息缺少 dispatch context。",
      "allowed_in_schemas": [
        "industry-agent-message.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "queue-dispatcher",
        "schema-validator"
      ],
      "consumer_required_behavior": "must_reject_before_queueing",
      "forbidden_synonyms": [
        "missing_dispatch_context"
      ]
    },
    {
      "code": "reservation_missing",
      "family": "dispatch",
      "meaning_cn": "需要 reservation 的动作缺少 granted reservation 引用。",
      "allowed_in_schemas": [
        "industry-agent-message.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "queue-dispatcher",
        "schema-validator"
      ],
      "consumer_required_behavior": "must_reject_before_execution",
      "forbidden_synonyms": [
        "missing_reservation"
      ]
    },
    {
      "code": "lineage_failed",
      "family": "lineage",
      "meaning_cn": "关键 lineage ref 缺失或无法解析。",
      "allowed_in_schemas": [
        "weekly-industry-trend-section.v2",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "weekly-packager",
        "replay-runner"
      ],
      "consumer_required_behavior": "must_block_ready_public_output",
      "forbidden_synonyms": [
        "lineage_missing",
        "trace_broken"
      ]
    },
    {
      "code": "reservation_superseded",
      "family": "dispatch",
      "meaning_cn": "当前 reservation 或 budget 记录已被后继记录替代。",
      "allowed_in_schemas": [
        "capacity-reservation.v1",
        "budget-arbitration-record.v1",
        "failure-notice.v1"
      ],
      "producer_roles": [
        "allocator-role",
        "main-coordinator-if-present"
      ],
      "consumer_required_behavior": "must_follow_supersede_chain",
      "forbidden_synonyms": [
        "reservation_replaced"
      ]
